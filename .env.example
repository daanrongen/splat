# Every SPLAT_* setting `splat` reads, generated by `splat env --export`.
#
# Regenerate with `splat env --export > .env.example`; `mise run check` fails
# if this file drifts from the CLI. Copy it to .env (gitignored) and uncomment
# what you want to change - every value shown is already the built-in default.
#
# mise loads .env via `_.file` in mise.toml, so an uncommented line applies to
# every `splat` run in an activated shell. Outside mise, either export the vars
# yourself or use `uv run --env-file .env splat ...`.
#
# Precedence: CLI flag > environment > built-in default. `splat env` shows what
# each setting currently resolves to and where it came from.

# ---  ---
# Show the full traceback on failure and third-party warnings.
# SPLAT_DEBUG=false
# Write -o files without a .manifest.json sidecar.
# SPLAT_NO_MANIFEST=false

# --- diffuse ---
# SPLAT_DIFFUSE_MODEL=sdxl-turbo-mlx
# SPLAT_DIFFUSE_NEGATIVE=
# SPLAT_DIFFUSE_SEED=
# Output width in pixels (multiple of 64, default 512; MLX backend only).
# SPLAT_DIFFUSE_WIDTH=
# Output height in pixels (multiple of 64, default 512; MLX backend only).
# SPLAT_DIFFUSE_HEIGHT=
# auto | cpu | mps
# SPLAT_DIFFUSE_DEVICE=auto

# --- caption ---
# SPLAT_CAPTION_MODEL=fastvlm-0.5b
# SPLAT_CAPTION_PROMPT=Describe this image in one concise sentence.
# SPLAT_CAPTION_MAX_TOKENS=80
# SPLAT_CAPTION_TEMPERATURE=0.0
# auto | cpu | mps
# SPLAT_CAPTION_DEVICE=auto

# --- embed ---
# SPLAT_EMBED_MODEL=mobileclip2-s0
# 'auto', 'mps', or 'cpu'.
# SPLAT_EMBED_DEVICE=auto

# --- segment ---
# SPLAT_SEGMENT_MODEL=sam-mlx
# SPLAT_SEGMENT_MAX_STICKERS=20
# auto | cpu | mps
# SPLAT_SEGMENT_DEVICE=auto

# --- depth ---
# SPLAT_DEPTH_MODEL=depth-pro
# auto | cpu | mps
# SPLAT_DEPTH_DEVICE=auto

# --- upscale ---
# Native upscale factor: 2 or 4.
# SPLAT_UPSCALE_FACTOR=4
# SPLAT_UPSCALE_MODEL=realesrgan-mlx
# Tile size for large images; 0 disables tiling.
# SPLAT_UPSCALE_TILE=0

# --- gaussian ---
# Reconstruction model, e.g. sharp or mlx3d-capture.
# SPLAT_GAUSSIAN_MODEL=sharp
# auto | cpu | mps
# SPLAT_GAUSSIAN_DEVICE=auto
# mlx3d quality preset.
# SPLAT_GAUSSIAN_QUALITY=fast
# Override training iterations.
# SPLAT_GAUSSIAN_ITERS=
# Max training image dimension.
# SPLAT_GAUSSIAN_MAX_DIM=
# Spherical harmonic degree.
# SPLAT_GAUSSIAN_SH_DEGREE=
# auto | colmap | builtin | existing
# SPLAT_GAUSSIAN_POSES=auto
# auto | on | off
# SPLAT_GAUSSIAN_REFINE_POSES=auto
# Use mlx3d low-memory mode.
# SPLAT_GAUSSIAN_LOW_MEM=false
# Random seed; <0 disables seeding.
# SPLAT_GAUSSIAN_SEED=0
# Drop isolated floater Gaussians after reconstruction.
# SPLAT_GAUSSIAN_DECLUTTER=false
# mlx3d-capture: even out exposure across the input views first.
# SPLAT_GAUSSIAN_NORMALIZE_COLOR=true
# sharp: 35mm-equivalent focal length assumed for images without EXIF.
# SPLAT_GAUSSIAN_FOCAL_35MM=30.0
# Fail instead of warning if the fraction of input images the backend registered falls below this (0-1).
# SPLAT_GAUSSIAN_MIN_REGISTERED=
# Render this many synthetic views of the reconstructed cloud, swept across --orbit-degrees, e.g. as multi-view input for a second `--model mlx3d-capture` pass.
# SPLAT_GAUSSIAN_ORBIT_FRAMES=
# Total azimuth sweep in degrees for --orbit-frames.
# SPLAT_GAUSSIAN_ORBIT_DEGREES=30.0
# Render source view 0 with Blender and record PSNR and SSIM against its photo.
# SPLAT_GAUSSIAN_SCORE=false
# Sticker (path or @id) of the first image; Gaussians outside it are dropped.
# SPLAT_GAUSSIAN_MASK=

# --- render ---
# Render backend.
# SPLAT_RENDER_MODEL=blender
# Render width in pixels.
# SPLAT_RENDER_WIDTH=1280
# Render height in pixels.
# SPLAT_RENDER_HEIGHT=720
# Render samples (backend-dependent).
# SPLAT_RENDER_SAMPLES=32
# cycles (accurate alpha-composited kernels) | eevee (fast preview).
# SPLAT_RENDER_ENGINE=cycles
# Backdrop: transparent, black, white, grey, or a hex colour.
# SPLAT_RENDER_BACKGROUND=black
# Orbit angle in degrees around the up axis (default 25).
# SPLAT_RENDER_AZIMUTH=
# Orbit angle in degrees above the horizon (default 20).
# SPLAT_RENDER_ELEVATION=
# Camera distance in the cloud's units (default fits the cloud).
# SPLAT_RENDER_DISTANCE=
# Framing multiplier: 1 fits the subject, 2 is twice as close (default 1).
# SPLAT_RENDER_ZOOM=
# Horizontal field of view in degrees.
# SPLAT_RENDER_FOV=
# Orbit centre as 'x,y,z' (default the cloud's median point).
# SPLAT_RENDER_LOOK_AT=
# Render from source camera N (0-based) instead of the primary capture pose.
# SPLAT_RENDER_VIEW=
# Blender executable when it isn't on PATH
# SPLAT_BLENDER_BIN=
# Seconds before a render is killed; 0 disables
# SPLAT_RENDER_TIMEOUT=1800

# --- mesh ---
# heightfield (depth map) | isosurface (gaussian cloud); default follows the input.
# SPLAT_MESH_MODEL=
# glb | obj | ply | gltf; default from -o, else glb.
# SPLAT_MESH_TO=
# isosurface: voxels along the longest axis.
# SPLAT_MESH_RESOLUTION=192
# isosurface: drop Gaussians below this opacity first.
# SPLAT_MESH_OPACITY_THRESHOLD=0.1

# --- export ---
# Gaussian clouds: compress first with web-delivery | archival.
# SPLAT_EXPORT_PROFILE=
# With --profile: threshold (default) | blue-noise (needs --target-count).
# SPLAT_EXPORT_PRUNING=

# --- validate ---
# Also flag valid-but-suspicious values.
# SPLAT_VALIDATE_STRICT=false

# --- http ---
# SPLAT_HOST=127.0.0.1:8000

# --- global ---
# Remote `splat http` base URL; unset runs everything locally
# SPLAT_URL=
# Converted/compiled model artifacts; defaults to $XDG_CACHE_HOME/splat/models
# SPLAT_MODEL_CACHE_DIR=
# One file per manifest; defaults to $XDG_CACHE_HOME/splat/manifests
# SPLAT_MANIFEST_CACHE_DIR=

# --- not read by splat itself ---
# Passed through to huggingface_hub for gated or private model repos.
# HF_TOKEN=
